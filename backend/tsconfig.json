{
    "compilerOptions": {
      "target": "ES2022",                                  
      "module": "commonjs",                                
      "lib": ["es2022"],                                   
      
      "rootDir": "./src",                                  
      "outDir": "./dist",
      
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,

      "strict": true,                                    
      "noImplicitAny": true,                           
      "esModuleInterop": true,                            
      

      "skipLibCheck": true,                            
      "forceConsistentCasingInFileNames": true          
    },
    "include": ["src/**/*"],                           
    "exclude": ["node_modules"]                      
  }